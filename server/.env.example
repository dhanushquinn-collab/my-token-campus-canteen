# Your network blocks SRV lookups, so use the direct (non +srv) form of the Atlas string:
# MONGO_URI=mongodb://user:pass@ac-xxxx-shard-00-00.xxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxx.mongodb.net:27017/token?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin&retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/token
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173
# Optional. Without a key the assistant falls back to a local recommender that still works.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
